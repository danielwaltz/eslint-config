{
  "name": "@danielwaltz/eslint-config",
  "type": "module",
  "version": "3.7.0",
  "author": "Daniel Waltz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielwaltz/eslint-config.git"
  },
  "keywords": [
    "eslint-config"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0"
    },
    "runtime": {
      "name": "node",
      "version": "24.18.0"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepack": "pnpm build",
    "release": "changelogen --release --push && pnpm publish",
    "test": "pnpm prepack && pnpm lint && pnpm type-check",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "prettier": ">=3"
  },
  "dependencies": {
    "@e18e/eslint-plugin": "^0.8.0",
    "@sxzz/eslint-config": "^8.6.0",
    "eslint-flat-config-utils": "^3.2.0",
    "eslint-plugin-erasable-syntax-only": "^0.7.1",
    "eslint-plugin-unicorn": "^74.0.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "~24.13.3",
    "changelogen": "^0.6.2",
    "eslint": "^10.10.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3"
  }
}
